{
    "compilerOptions": {
        "target": "es2020",
        "module": "commonjs",
        "rootDir": "src",
        "moduleResolution": "node",
        "baseUrl": "src",
        "outDir": "./dist",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": false,
        "noImplicitAny": false,
        "noEmitOnError": false,
        "skipLibCheck": true,
        "suppressImplicitAnyIndexErrors": true
    },
    "include": ["src/**/*"],

    "exclude": [
        "node_modules"
    ]
}